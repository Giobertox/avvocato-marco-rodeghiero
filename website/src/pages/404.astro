---
import Layout from '../layouts/Layout.astro';
import { copy, routes } from '../data/site';
import { withBase } from '../utils/paths';
const t = copy.it;
const english = copy.en;
---
<Layout locale="it" pageKey="home" title="Pagina non trovata · Page not found" description={`${t.notFoundText} ${english.notFoundText}`} forceNoIndex sharingURL={withBase('/404.html')}><section class="page-heading container"><p class="eyebrow">404</p><h1>{t.notFound} · <span lang="en">{english.notFound}</span></h1><p class="page-lead">{t.notFoundText}</p><p lang="en">{english.notFoundText}</p><div class="actions"><a class="button" href={routes.it.home}>{t.back}</a><a class="text-link" href={routes.en.home} lang="en">{english.back} · English</a></div></section></Layout>
