---
import Icon from './Icon.astro';
import { copy, studio, emailLink, type Locale } from '../data/site';
interface Props { locale: Locale; light?: boolean; translation?: boolean; id?: string; }
const { locale, light = false, translation = false, id = 'contact-actions' } = Astro.props;
const t = copy[locale];
const emailHintId = `${id}-email-hint`;
---
<div class:list={['actions', { 'actions-translation': translation }]}>
  {translation ? <>
    <a class:list={['button', { 'button-light': light }]} href={emailLink(t.translationSubject)} aria-describedby={emailHintId}><Icon name="mail" />{t.translationRequest}</a>
    <a class:list={['button', 'button-secondary', { 'button-outline-light': light }]} href={studio.phoneHref}><Icon name="phone" />{t.callShort}</a>
  </> : <>
    <a class:list={['button', { 'button-light': light }]} href={studio.phoneHref}><Icon name="phone" />{t.callShort}</a>
    <a class:list={['button', 'button-secondary', { 'button-outline-light': light }]} href={emailLink()} aria-describedby={emailHintId}><Icon name="mail" />{t.emailShort}</a>
  </>}
</div>
<p id={emailHintId} class="small-note action-hint">{t.emailActionHint}</p>
