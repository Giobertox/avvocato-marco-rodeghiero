---
import Layout from '../layouts/Layout.astro';
import ContactBand from './ContactBand.astro';
import ContactActions from './ContactActions.astro';
import NewTabCue from './NewTabCue.astro';
import Icon, { type IconName } from './Icon.astro';
import { withBase } from '../utils/paths';
import { copy, routes, studio, areas, profileDetails, emailLink, type Locale, type PageKey } from '../data/site';
const { locale, pageKey } = Astro.props as { locale: Locale; pageKey: PageKey };
const t = copy[locale];
const pageTitle = pageKey === 'home' ? `${locale === 'it' ? 'Avvocato a Vicenza' : 'Lawyer in Vicenza, Italy'} · Avv. Marco Rodeghiero` : t.nav[pageKey];
const descriptions = { home: t.summary, profile: t.profileLead, areas: t.areasIntro, translations: t.translationIntro, contact: t.contactText };
const areaIcons: Record<string, IconName> = { civile: 'scale', famiglia: 'users-round', immobili: 'house', impresa: 'briefcase-business' };
---
<Layout locale={locale} pageKey={pageKey} title={pageTitle} description={descriptions[pageKey]}>
  {pageKey === 'home' && <>
    <section class="home-hero">
      <img class="hero-background" src={withBase('/branding/vicenza_BG.webp?v=2')} width="1400" height="500" alt="" fetchpriority="high" decoding="async" />
      <div class="hero container">
        <div class="hero-copy">
          <p class="eyebrow">{t.intro}</p>
          <h1>{t.hero}</h1>
          <p class="hero-summary">{t.heroLead}</p>
          <div class="facts"><span><Icon name="languages" />{t.languageLabel}</span><span><Icon name="video" />{t.meetingLabel}</span><span><Icon name="calendar-days" />{t.appointmentLabel}</span></div>
          <ContactActions locale={locale} light />
        </div>
        <aside class="hero-office"><Icon name="map-pin" /><div><span>{t.addressLabel}</span><strong>{studio.address}</strong><p>Vicenza · Italia</p><a class="text-link" href={routes[locale].contact}>{t.nav.contact}</a></div></aside>
      </div>
    </section>
    <section class="section container home-services">
      <div class="section-heading"><h2>{t.areaTitle}</h2></div>
      <div class="service-list">{areas[locale].map(area => <a class="service-row" data-area={area.id} href={`${routes[locale].areas}#${area.id}`}><Icon name={areaIcons[area.id]} /><div><h3>{area.title}</h3><p>{area.text}</p></div><span class="row-arrow" aria-hidden="true">→</span></a>)}</div>
      <a class="text-link section-link" href={routes[locale].areas}><Icon name="book-open" />{t.areaLink}</a>
    </section>
    <section class="section container editorial-pair">
      <div class="translation-teaser"><p class="eyebrow">{t.supplementary}</p><h2>{t.translationTitle}</h2><p>{t.translationText}</p><a class="text-link" href={routes[locale].translations}><Icon name="languages" />{t.translationLink}</a></div>
      <div class="profile-teaser"><div class="profile-teaser-heading"><img class="teaser-portrait photo" src={withBase('/images/avvocato_marco_profile.webp')} width="1254" height="1254" alt={t.portraitAlt} loading="lazy" decoding="async" /><div><p class="eyebrow">{t.profileEyebrow}</p><h2>{t.profileTitle}</h2></div></div><p>{t.profileText}</p><a class="text-link" href={routes[locale].profile}>{t.profileLink}</a></div>
    </section>
    <section class="section section-tinted">
      <div class="container home-office"><div class="home-office-info"><div><h2><Icon name="map-pin" />{t.addressLabel}</h2><p class="address-line">{studio.address}, Vicenza</p><a class="text-link" href={studio.maps} target="_blank" rel="noopener noreferrer" title={t.newTab}>{t.directionsShort}<NewTabCue locale={locale} /></a></div><div><h3><Icon name="clock" />{t.hoursLabel}</h3><p><strong>{t.byAppointment}</strong></p><p>{t.weekdays}<br />9:00–13:00 · 15:00–19:00</p><p class="small-note">{t.weekend}: {t.closed.toLowerCase()}</p></div></div><div class="office-interior-frame"><img class="office-interior photo" src={withBase('/images/office-interior.webp')} width="800" height="600" alt={t.officeInteriorAlt} loading="lazy" decoding="async" /></div></div>
    </section>
    <ContactBand locale={locale} />
  </>}

  {pageKey === 'profile' && <>
    <section class="container profile-introduction">
      <header class="page-heading"><p class="eyebrow">{t.nav.profile}</p><h1>Avv. Marco Rodeghiero</h1><p>{t.profileLead}</p></header>
      <img class="profile-portrait photo" src={withBase('/images/avvocato_marco_profile.webp')} width="1254" height="1254" alt={t.portraitAlt} decoding="async" />
      <div class="profile-bio"><p>{t.bio}</p><a class="text-link" href={studio.linkedin} target="_blank" rel="noopener noreferrer" title={t.newTab}>{t.profileSource}<NewTabCue locale={locale} /></a></div>
    </section>
    <section class="section container profile-sections">
      <article><h2>{t.profileFocus}</h2><p>{t.profileFocusText}</p><a class="text-link" href={routes[locale].areas}>{t.areaLink}</a></article>
      <article><h2>{t.profileEducation}</h2><ul class="profile-facts">{profileDetails[locale].education.map(item => <li><h3>{item.title}</h3><p>{item.detail}</p></li>)}</ul></article>
      <article><h2>{t.profileExperience}</h2><ul class="profile-facts">{profileDetails[locale].experience.map(item => <li><h3>{item.title}</h3><p>{item.detail}</p></li>)}</ul></article>
      <article><h2>{t.languages}</h2><p>{t.profileLanguagesText}</p><a class="text-link" href={routes[locale].translations}>{t.translationLink}</a></article>
      <article><h2>{t.profileMeeting}</h2><p>{t.profileMeetingText}</p><a class="text-link" href={routes[locale].contact}>{t.nav.contact} · {t.addressLabel.toLowerCase()}</a></article>
    </section>
    <ContactBand locale={locale} />
  </>}

  {pageKey === 'areas' && <>
    <section class="page-heading container"><h1>{t.nav.areas}</h1><p>{t.areasIntro}</p></section>
    <section class="container areas-layout">
      <nav class="area-toc" aria-label={t.nav.areas}>{areas[locale].map(a => <a data-area={a.id} href={`#${a.id}`}><Icon name={areaIcons[a.id]} /><span>{a.title}</span></a>)}<a class="area-toc-translation" href={routes[locale].translations}><Icon name="languages" /><span>{t.nav.translations}</span></a></nav>
      <div class="area-details">{areas[locale].map(a => <article id={a.id} data-area={a.id}><h2><Icon name={areaIcons[a.id]} />{a.title}</h2><p>{a.detail}</p><p class="area-when"><strong>{t.situationLabel}</strong>{a.when}</p></article>)}<article><p class="eyebrow">{t.supplementary}</p><h2>{t.translationTitle}</h2><p>{t.translationText}</p><a class="text-link" href={routes[locale].translations}>{t.translationLink}</a></article></div>
    </section>
    <ContactBand locale={locale} />
  </>}

  {pageKey === 'translations' && <>
    <section class="page-heading container"><span class="language-badge"><Icon name="languages" />{t.translationDirection}</span><h1>{t.translationTitle}</h1><p>{t.translationIntro}</p><ContactActions locale={locale} translation /></section>
    <section class="container translation-body"><article><h2><Icon name="file-text" />{t.translationScope}</h2><p>{t.translationScopeText}</p></article><article><h2><Icon name="book-open" />{t.translationLimits}</h2><p>{t.translationLimitsText}</p></article></section>
    <section class="section container request-section"><h2>{t.requestTitle}</h2><ol class="request-steps">{t.translationSteps.map(step => <li>{step}</li>)}</ol></section>
    <ContactBand locale={locale} translation />
  </>}

  {pageKey === 'contact' && <>
    <section class="page-heading container contact-heading"><h1>{t.nav.contact}</h1><p>{t.contactIntro}</p><ContactActions locale={locale} /></section>
    <section class="container contact-grid">
      <div class="contact-methods"><h2>{t.contactDetails}</h2><a class="contact-detail" href={studio.phoneHref}><Icon name="phone" /><div><span>{t.phoneLabel}</span><strong>{studio.phone}</strong></div></a><a class="contact-detail" href={emailLink()}><Icon name="mail" /><div><span>{t.ordinaryEmail}</span><strong>{studio.email}</strong></div></a><a class="text-link appointment-link" href={emailLink(t.appointmentSubject)} aria-describedby="appointment-note"><Icon name="calendar-days" />{t.appointment}</a><p id="appointment-note" class="small-note">{t.appointmentNote}</p>
        <section class="contact-meeting-block">
          <h2><Icon name="clock" />{t.hoursLabel}</h2>
          <p><strong>{t.byAppointment}</strong></p>
          <dl class="hours"><div><dt>{t.weekdays}</dt><dd>9:00–13:00<br />15:00–19:00</dd></div><div><dt>{t.weekend}</dt><dd>{t.closed}</dd></div></dl>
        </section>
        <section class="contact-meeting-block">
          <h2><Icon name="video" />{t.remoteTitle}</h2>
          <p>{t.remoteText}</p>
        </section>
      </div>
      <aside id="sede" class="office-card"><h2><Icon name="map-pin" />{t.addressLabel}</h2><p class="office-address">{studio.address}</p><p>{studio.city}</p><figure class="office-location-photo"><img class="photo" src={withBase('/images/office_entrance.webp')} width="993" height="600" alt={t.officeExteriorAlt} loading="lazy" decoding="async" /><figcaption>{studio.address} · {t.officeExteriorCaption}</figcaption></figure><a class="button button-secondary directions-button" href={studio.maps} target="_blank" rel="noopener noreferrer" title={t.newTab}><Icon name="map-pin" />{t.directionsShort}<NewTabCue locale={locale} /></a><p class="small-note">{t.mapsNote}</p></aside>
    </section>
    <section id="pec" class="container pec-section"><h2><Icon name="mail" />{t.pecLabel}</h2><a class="pec-link" href={`mailto:${studio.pec}`}>{studio.pec}</a><p class="small-note">{t.pecNote}</p></section>
    <section id="informazioni" class="container legal-placeholder"><h2>{t.legalTitle}</h2><p>{t.legalText}</p><span class="status-label">{t.provisional}</span></section>
  </>}
</Layout>
