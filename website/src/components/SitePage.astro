---
import Layout from '../layouts/Layout.astro';
import ContactBand from './ContactBand.astro';
import ContactActions from './ContactActions.astro';
import Icon, { type IconName } from './Icon.astro';
import { copy, routes, studio, areas, emailLink, type Locale, type PageKey } from '../data/site';
const { locale, pageKey } = Astro.props as { locale: Locale; pageKey: PageKey };
const t = copy[locale];
const pageTitle = pageKey === 'home' ? `${locale === 'it' ? 'Avvocato a Vicenza' : 'Lawyer in Vicenza, Italy'} · Marco Rodeghiero` : t.nav[pageKey];
const descriptions = { home: t.summary, profile: t.profileLead, areas: t.areasIntro, translations: t.translationIntro, contact: t.contactText };
const areaIcons: Record<string, IconName> = { civile: 'scale', famiglia: 'users-round', immobili: 'house', impresa: 'briefcase-business' };
---
<Layout locale={locale} pageKey={pageKey} title={pageTitle} description={descriptions[pageKey]}>
  {pageKey === 'home' && <>
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow">{t.intro}</p>
        <h1>{t.hero}</h1>
        <p class="hero-summary">{t.heroLead}</p>
        <div class="facts"><span><Icon name="languages" />{t.languageLabel}</span><span><Icon name="video" />{t.meetingLabel}</span></div>
        <ContactActions locale={locale} />
      </div>
      <aside class="hero-office"><Icon name="map-pin" /><div><span>{t.addressLabel}</span><strong>{studio.address}</strong><p>Vicenza · Italia</p><a class="text-link" href={routes[locale].contact}>{t.nav.contact}</a></div></aside>
    </section>
    <section class="section container home-services">
      <div class="section-heading"><h2>{t.areaTitle}</h2><p>{t.practiceIntro}</p></div>
      <div class="service-list">{areas[locale].map(area => <a class="service-row" href={`${routes[locale].areas}#${area.id}`}><span class="icon-tile"><Icon name={areaIcons[area.id]} /></span><div><h3>{area.title}</h3><p>{area.items.filter(item => item !== area.title).join(' · ')}</p></div></a>)}</div>
      <a class="text-link section-link" href={routes[locale].areas}><Icon name="book-open" />{t.areaLink}</a>
    </section>
    <section class="section section-tinted">
      <div class="container profile-teaser"><span class="icon-tile"><Icon name="user-round" /></span><div><h2>{t.profileTitle}</h2><p>{t.profileText}</p><a class="text-link" href={routes[locale].profile}>{t.profileLink}</a></div></div>
    </section>
    <section class="section container translation-teaser">
      <span class="icon-tile"><Icon name="languages" /></span><div><h2>{t.translationTitle}</h2><p>{t.translationText}</p><a class="text-link" href={routes[locale].translations}>{t.translationLink}</a></div>
    </section>
    <section class="section section-tinted">
      <div class="container home-office"><div><h2><Icon name="map-pin" />{t.addressLabel}</h2><p class="address-line">{studio.address}, Vicenza</p><a class="text-link" href={studio.maps} target="_blank" rel="noopener noreferrer">{t.directionsShort}</a></div><div><h3><Icon name="clock" />{t.hoursLabel}</h3><p>{t.weekdays}<br />9:00–13:00 · 15:00–19:00</p><p class="small-note">{t.weekend}: {t.closed.toLowerCase()}</p></div></div>
    </section>
    <ContactBand locale={locale} />
  </>}

  {pageKey === 'profile' && <>
    <section class="page-heading container"><p class="eyebrow">{t.nav.profile}</p><h1>Marco Rodeghiero</h1><p>{t.profileLead}</p></section>
    <section class="container profile-body">
      <div class="profile-bio"><p>{t.bio}</p><div class="facts"><span><Icon name="languages" />{t.languageLabel}</span><span><Icon name="map-pin" />Vicenza</span></div><p class="small-note">{t.languageLevels}</p><a class="text-link" href={routes[locale].contact}><Icon name="mail" />{t.nav.contact}</a></div>
      <aside class="portrait-placeholder"><Icon name="user-round" /><div><strong>{t.portrait}</strong><p>{t.portraitNote}</p></div></aside>
    </section>
    <section class="section container narrow-section">
      <div class="section-heading"><h2><Icon name="graduation-cap" />{t.education}</h2><span class="status-label">{t.provisional}</span></div>
      <div class="timeline"><article><span class="timeline-date">1997–2003</span><div><h3>{t.degree}</h3><p>{t.degreeDetail}</p></div></article><article><span class="timeline-date">2004–2007</span><div><h3>{t.doctorate}</h3><p>{t.doctorateDetail}</p></div></article></div>
      <p class="small-note">{t.educationNote}</p>
      <div class="experience-block"><h2><Icon name="briefcase-business" />{t.experience}</h2><h3>{t.practiceSince}</h3><p>{t.practiceSinceDetail}</p></div>
      <div class="pending-box"><h2><Icon name="book-open" />{t.registration}</h2><p>{t.registrationDetail}</p><span class="status-label">{t.provisional}</span></div>
    </section>
    <ContactBand locale={locale} />
  </>}

  {pageKey === 'areas' && <>
    <section class="page-heading container"><h1>{t.nav.areas}</h1><p>{t.areasIntro}</p></section>
    <section class="container areas-layout">
      <nav class="area-toc" aria-label={t.nav.areas}>{areas[locale].map(a => <a href={`#${a.id}`}><Icon name={areaIcons[a.id]} />{a.title}</a>)}<a href={routes[locale].translations}><Icon name="languages" />{t.nav.translations}</a></nav>
      <div class="area-details">{areas[locale].map(a => <article id={a.id}><div class="area-heading"><span class="icon-tile"><Icon name={areaIcons[a.id]} /></span><h2>{a.title}</h2></div><p>{a.text}</p><ul>{a.items.map(item => <li>{item}</li>)}</ul></article>)}<article><div class="area-heading"><span class="icon-tile"><Icon name="languages" /></span><h2>{t.translationTitle}</h2></div><p>{t.translationText}</p><a class="text-link" href={routes[locale].translations}>{t.translationLink}</a></article></div>
    </section>
    <ContactBand locale={locale} />
  </>}

  {pageKey === 'translations' && <>
    <section class="page-heading container"><span class="language-badge"><Icon name="languages" />{t.translationDirection}</span><h1>{t.translationTitle}</h1><p>{t.translationIntro}</p><ContactActions locale={locale} translation /></section>
    <section class="container translation-body"><article><h2><Icon name="file-text" />{t.translationScope}</h2><p>{t.translationScopeText}</p></article><article><h2><Icon name="book-open" />{t.translationLimits}</h2><p>{t.translationLimitsText}</p></article></section>
    <section class="section container request-section"><h2>{t.requestTitle}</h2><ol class="request-steps">{t.translationSteps.map(step => <li>{step}</li>)}</ol></section>
    <ContactBand locale={locale} />
  </>}

  {pageKey === 'contact' && <>
    <section class="page-heading container contact-heading"><h1>{t.nav.contact}</h1><p>{t.contactIntro}</p><ContactActions locale={locale} /></section>
    <section class="container contact-grid">
      <div class="contact-methods"><h2>{t.contactDetails}</h2><a class="contact-detail" href={studio.phoneHref}><Icon name="phone" /><div><span>{t.phoneLabel}</span><strong>{studio.phone}</strong></div></a><a class="contact-detail" href={emailLink()}><Icon name="mail" /><div><span>{t.ordinaryEmail}</span><strong>{studio.email}</strong></div></a><a class="text-link appointment-link" href={emailLink(t.appointmentSubject)}><Icon name="calendar-days" />{t.appointment}</a><p class="small-note">{t.appointmentNote}</p></div>
      <aside id="sede" class="office-card"><h2><Icon name="map-pin" />{t.addressLabel}</h2><p class="office-address">{studio.address}</p><p>{studio.city}</p><a class="button button-secondary directions-button" href={studio.maps} target="_blank" rel="noopener noreferrer"><Icon name="map-pin" />{t.directionsShort}</a><p class="small-note">{t.mapsNote}</p><hr /><h3><Icon name="clock" />{t.hoursLabel}</h3><dl class="hours"><div><dt>{t.weekdays}</dt><dd>9:00–13:00<br />15:00–19:00</dd></div><div><dt>{t.weekend}</dt><dd>{t.closed}</dd></div></dl><hr /><h3><Icon name="video" />{t.remoteTitle}</h3><p>{t.remoteText}</p></aside>
    </section>
    <section id="pec" class="container pec-section"><h2><Icon name="mail" />{t.pecLabel}</h2><a class="pec-link" href={`mailto:${studio.pec}`}>{studio.pec}</a><p class="small-note">{t.pecNote}</p></section>
    <section id="informazioni" class="container legal-placeholder"><h2>{t.legalTitle}</h2><p>{t.legalText}</p><span class="status-label">{t.provisional}</span></section>
  </>}
</Layout>
