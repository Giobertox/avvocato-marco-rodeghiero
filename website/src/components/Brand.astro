---
import { withBase } from '../utils/paths';
import { routes, studio, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const logo = withBase('/branding/studio-logo-blue.webp');
---
<a class="wordmark" href={routes[locale].home} aria-label={studio.name}>
  <img class="brand-full" src={logo} width="841" height="400" alt="" decoding="async" />
  <span class="brand-symbol" aria-hidden="true"><img src={logo} width="841" height="400" alt="" decoding="async" /></span>
  <span class="wordmark-copy"><strong>Marco Rodeghiero</strong><span>{locale === 'it' ? 'Studio legale' : 'Legal practice'}</span></span>
</a>
