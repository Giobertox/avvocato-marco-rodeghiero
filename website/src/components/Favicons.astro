---
import { withBase } from '../utils/paths';
import type { Locale } from '../data/site';
import faviconSvg from '../branding/favicon.svg?raw';
import { faviconHead } from '../../lib/favicons.mjs';
interface Props { locale?: Locale; }
const { locale = 'it' } = Astro.props;
const head = faviconHead(faviconSvg, locale);
---
<meta name="theme-color" content={head.themeColor} />
<meta name="apple-mobile-web-app-title" content={head.shortName} />
{head.links.map(link => <link rel={link.rel} type={link.type} sizes={link.sizes} href={withBase(link.href)} />)}
