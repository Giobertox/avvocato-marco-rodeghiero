---
import '../styles/global.css';
import Icon, { type IconName } from '../components/Icon.astro';
import RobotsMeta from '../components/RobotsMeta.astro';
import Brand from '../components/Brand.astro';
import { indexingEnabled } from '../../config/seo.mjs';
import { withBase } from '../utils/paths';
import { copy, routes, studio, emailLink, type Locale, type PageKey } from '../data/site';
interface Props { locale: Locale; pageKey: PageKey; title: string; description: string; forceNoIndex?: boolean; }
const { locale, pageKey, title, description, forceNoIndex = false } = Astro.props;
const t = copy[locale];
const other = locale === 'it' ? 'en' : 'it';
const navKeys: PageKey[] = ['home', 'areas', 'contact', 'translations', 'profile'];
const navIcons: Record<PageKey, IconName> = { home: 'house', areas: 'scale', contact: 'mail', translations: 'languages', profile: 'user-round' };
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Studio Legale Avv. Marco Rodeghiero</title>
    <meta name="description" content={description} />
    <RobotsMeta forceNoIndex={forceNoIndex} />
    <meta name="theme-color" content="#6a0d0f" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'it' ? 'it_IT' : 'en_GB'} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    {!indexingEnabled && <div class="draft-banner"><div class="container draft-inner" title={t.stageDetail}><strong>{t.stage}</strong><span>{locale === 'it' ? 'In revisione' : 'Under review'}</span></div></div>}
    <header class="site-header">
      <div class="container header-inner">
        <Brand locale={locale} />
        <nav class="main-nav" aria-label={locale === 'it' ? 'Navigazione principale' : 'Main navigation'}>
          {navKeys.filter(key => key !== 'home').map(key => <a href={routes[locale][key]} aria-current={pageKey === key ? 'page' : undefined}>{t.nav[key]}</a>)}
        </nav>
        <div class="header-tools"><div class="language-nav" aria-label={locale === 'it' ? 'Lingua' : 'Language'}><a href={routes.it[pageKey]} lang="it" aria-label="Italiano" aria-current={locale === 'it' ? 'true' : undefined}>IT</a><a href={routes.en[pageKey]} lang="en" aria-label="English" aria-current={locale === 'en' ? 'true' : undefined}>EN</a></div><a class="header-phone" href={studio.phoneHref}><Icon name="phone" />{studio.phone}</a></div>
        <details class="mobile-nav">
          <summary><span class="menu-label"><Icon name="menu" class="menu-open-icon" /><Icon name="x" class="menu-close-icon" /><span class="menu-open-label">{t.menu}</span><span class="menu-close-label">{t.close}</span></span><Icon name="chevron-down" class="menu-chevron" /></summary>
          <nav aria-label={locale === 'it' ? 'Navigazione mobile' : 'Mobile navigation'}>{navKeys.map(key => <a href={routes[locale][key]} aria-current={pageKey === key ? 'page' : undefined}><Icon name={navIcons[key]} />{t.nav[key]}</a>)}</nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-identity"><a class="footer-name" href={routes[locale].home}>Avv. Marco Rodeghiero</a><p>Studio legale · Vicenza</p></div>
        <div class="footer-address"><Icon name="map-pin" /><div><p>{studio.address}<br />{studio.city}</p><a class="text-link" href={`${routes[locale].contact}#sede`}>{t.addressLabel}</a></div></div>
        <div class="footer-contacts"><a href={studio.phoneHref}><Icon name="phone" />{studio.phone}</a><a href={emailLink()}><Icon name="mail" /><span>{studio.email}</span></a><a class="text-link" href={`${routes[locale].contact}#pec`}>{locale === 'it' ? 'PEC dello Studio' : 'Practice PEC address'}</a></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getUTCFullYear()} Studio Legale Avv. Marco Rodeghiero</span><a href={`${routes[locale].contact}#informazioni`}>{t.legalTitle}</a><a href={routes[other][pageKey]} lang={other}>{other === 'en' ? 'English version' : 'Versione italiana'}</a></div>
    </footer>
  </body>
</html>
